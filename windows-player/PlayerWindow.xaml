<Window x:Class="VoltixIptvWindows.PlayerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
    Title="Iqraa IPTV Player" Width="1100" Height="700"
    MinWidth="760" MinHeight="480"
    WindowStartupLocation="CenterOwner" Background="#05070B">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#191E28" Padding="12">
            <TextBlock x:Name="TitleText" Foreground="White" FontSize="16" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>
        </Border>
        <Grid Grid.Row="1" Background="Black">
            <vlc:VideoView x:Name="Video" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
            <Border x:Name="ErrorOverlay" Visibility="Collapsed" Background="#CC000000">
                <TextBlock x:Name="ErrorText" Foreground="White" FontSize="20" TextWrapping="Wrap"
                           TextAlignment="Center" VerticalAlignment="Center" Margin="40"
                           Text="تعذر تشغيل البث. تحقق من الرابط أو بيانات الاشتراك."/>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#191E28" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="PlayPauseButton" Content="إيقاف مؤقت" Click="PlayPause_Click"
                        Padding="18,8" Margin="5" Background="#49D7C5"/>
                <Button Content="إغلاق المشغل" Click="ClosePlayer_Click" Padding="18,8" Margin="5"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>