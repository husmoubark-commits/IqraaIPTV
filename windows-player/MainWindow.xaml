<Window x:Class="VoltixIptvWindows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Voltix IPTV Player" Width="1200" Height="760"
    WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}"
    FlowDirection="RightToLeft">
    <Grid Margin="18">
        <Grid x:Name="LoginView" Visibility="Visible">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Width="540" HorizontalAlignment="Center" Margin="20,22">
                    <TextBlock Text="Voltix IPTV Player" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="أدخل بيانات الاشتراك" Foreground="{StaticResource MutedBrush}" FontSize="17" HorizontalAlignment="Center" Margin="0,8,0,22"/>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="5" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="XtreamButton" Content="Xtream Codes" Click="XtreamMode_Click" Padding="22,10" Background="{StaticResource AccentBrush}" Foreground="White"/>
                            <Button x:Name="M3uButton" Content="رابط M3U" Click="M3uMode_Click" Padding="22,10" Background="Transparent" Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="اسم البروفايل (اختياري)" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,5"/>
                    <TextBox x:Name="ProfileBox" Padding="10" FontSize="15"/>

                    <StackPanel x:Name="XtreamFields">
                        <TextBlock Text="رابط السيرفر — مثال: http://host:port" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,5"/>
                        <TextBox x:Name="ServerBox" Padding="10" FontSize="15"/>
                        <TextBlock Text="اسم المستخدم" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,5"/>
                        <TextBox x:Name="UserBox" Padding="10" FontSize="15"/>
                        <TextBlock Text="كلمة المرور" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,5"/>
                        <PasswordBox x:Name="PassBox" Padding="10" FontSize="15"/>
                    </StackPanel>

                    <StackPanel x:Name="M3uFields" Visibility="Collapsed">
                        <TextBlock Text="رابط قائمة M3U" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,5"/>
                        <TextBox x:Name="M3uBox" Padding="10" FontSize="15"/>
                    </StackPanel>

                    <TextBlock x:Name="LoginError" Foreground="#FFFF6B6B" TextWrapping="Wrap" Margin="0,14,0,0"/>
                    <Button Content="تسجيل الدخول" Click="Login_Click" Height="50" Margin="0,20,0,0" Background="{StaticResource AccentBrush}" Foreground="White" FontSize="16"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="BrowseView" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Voltix IPTV Player" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        <TextBlock x:Name="ProfileText" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="التنزيلات" Click="Downloads_Click" Padding="14,9" Margin="8,0"/>
                    <Button Grid.Column="2" Content="تحديث" Click="Refresh_Click" Padding="14,9" Margin="8,0" Background="{StaticResource AccentBrush}"/>
                    <Button Grid.Column="3" Content="تسجيل خروج" Click="Logout_Click" Padding="14,9" Margin="8,0"/>
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Margin="0,12,0,12">
                <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="100" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock x:Name="StatusText" Text="جاهز" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
            </StackPanel>
            <TabControl Grid.Row="2" x:Name="Tabs" Background="{StaticResource PanelBrush}" BorderThickness="0">
                <TabItem Header="المسلسلات">
<Grid Margin="8" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Margin="4" Padding="8"><DockPanel FlowDirection="RightToLeft">
<TextBlock DockPanel.Dock="Top" Text="التصنيفات" Foreground="White" FontSize="18" FontWeight="Bold" Margin="6,4,6,10"/>
<ListBox x:Name="SeriesCategories" SelectionChanged="SeriesCategory_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.VerticalScrollBarVisibility="Auto">
<ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,9"/><Setter Property="HorizontalContentAlignment" Value="Right"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="Transparent"/><Setter Property="Margin" Value="0,2"/>
<Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#626775"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle></ListBox></DockPanel></Border>
<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" FlowDirection="RightToLeft"><WrapPanel x:Name="SeriesPanel" Margin="12"/></ScrollViewer></Grid></TabItem>
                <TabItem Header="الأفلام">
<Grid Margin="8" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Margin="4" Padding="8"><DockPanel FlowDirection="RightToLeft">
<TextBlock DockPanel.Dock="Top" Text="التصنيفات" Foreground="White" FontSize="18" FontWeight="Bold" Margin="6,4,6,10"/>
<ListBox x:Name="MoviesCategories" SelectionChanged="MoviesCategory_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.VerticalScrollBarVisibility="Auto">
<ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,9"/><Setter Property="HorizontalContentAlignment" Value="Right"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="Transparent"/><Setter Property="Margin" Value="0,2"/>
<Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#626775"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle></ListBox></DockPanel></Border>
<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" FlowDirection="RightToLeft"><WrapPanel x:Name="MoviesPanel" Margin="12"/></ScrollViewer></Grid></TabItem>
                <TabItem Header="اللايف">
<Grid Margin="8" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="8" Margin="4" Padding="8"><DockPanel FlowDirection="RightToLeft">
<TextBlock DockPanel.Dock="Top" Text="التصنيفات" Foreground="White" FontSize="18" FontWeight="Bold" Margin="6,4,6,10"/>
<ListBox x:Name="LiveCategories" SelectionChanged="LiveCategory_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.VerticalScrollBarVisibility="Auto">
<ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,9"/><Setter Property="HorizontalContentAlignment" Value="Right"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="Transparent"/><Setter Property="Margin" Value="0,2"/>
<Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#626775"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle></ListBox></DockPanel></Border>
<ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" FlowDirection="RightToLeft"><WrapPanel x:Name="LivePanel" Margin="12"/></ScrollViewer></Grid></TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
