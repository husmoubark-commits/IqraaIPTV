<Window x:Class="VoltixIptvWindows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Iqraa IPTV" Width="1360" Height="820" MinWidth="1000" MinHeight="650"
    WindowStartupLocation="CenterScreen" Background="#0D1020" FlowDirection="RightToLeft">
    <Window.Resources>
        <SolidColorBrush x:Key="PageBrush" Color="#0D1020"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#171A2D"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#19A7F6"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#AAB0C6"/>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#222640"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="15,9"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="18" Padding="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid x:Name="LoginView" Visibility="Visible">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Width="540" HorizontalAlignment="Center" Margin="20,22">
                    <TextBlock Text="Iqraa IPTV" Foreground="White" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="أدخل بيانات الاشتراك" Foreground="{StaticResource MutedBrush}" FontSize="17" HorizontalAlignment="Center" Margin="0,8,0,22"/>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="5" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="XtreamButton" Content="Xtream Codes" Click="XtreamMode_Click" Padding="22,10" Background="{StaticResource AccentBrush}" Foreground="White"/>
                            <Button x:Name="M3uButton" Content="رابط M3U" Click="M3uMode_Click" Padding="22,10" Background="Transparent" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="اسم البروفايل (اختياري)" Foreground="{StaticResource MutedBrush}" Margin="0,18,0,5"/>
                    <TextBox x:Name="ProfileBox" Padding="10" FontSize="15"/>
                    <StackPanel x:Name="XtreamFields">
                        <TextBlock Text="رابط السيرفر — مثال: http://host:port" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,5"/>
                        <TextBox x:Name="ServerBox" Padding="10" FontSize="15"/>
                        <TextBlock Text="اسم المستخدم" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,5"/>
                        <TextBox x:Name="UserBox" Padding="10" FontSize="15"/>
                        <TextBlock Text="كلمة المرور" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,5"/>
                        <PasswordBox x:Name="PassBox" Padding="10" FontSize="15"/>
                    </StackPanel>
                    <StackPanel x:Name="M3uFields" Visibility="Collapsed">
                        <TextBlock Text="رابط قائمة M3U" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,5"/>
                        <TextBox x:Name="M3uBox" Padding="10" FontSize="15"/>
                    </StackPanel>
                    <TextBlock x:Name="LoginError" Foreground="#FFFF6B6B" TextWrapping="Wrap" Margin="0,14,0,0"/>
                    <Button Content="تسجيل الدخول" Click="Login_Click" Height="50" Margin="0,20,0,0" Background="{StaticResource AccentBrush}" Foreground="White" FontSize="16"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="BrowseView" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <Grid x:Name="HomeView" Grid.Row="0" Visibility="Visible">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="14" Margin="0,0,0,16">
                    <Grid FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="◉" Foreground="{StaticResource AccentBrush}" FontSize="26" FontWeight="Bold" Margin="5,0,12,0"/>
                            <StackPanel>
                                <TextBlock Text="Iqraa IPTV" Foreground="White" FontSize="21" FontWeight="Bold"/>
                                <TextBlock x:Name="ProfileText" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            </StackPanel>
                            <Border Background="#20253D" CornerRadius="15" Padding="12,7" Margin="24,0">
                                <TextBlock Text="⌕  Master Search" Foreground="{StaticResource MutedBrush}" FontSize="14"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource ActionButton}" Content="⟳" ToolTip="تحديث" Click="Refresh_Click"/>
                            <Button Style="{StaticResource ActionButton}" Content="⬇" ToolTip="التنزيلات" Click="Downloads_Click"/>
                            <Button Style="{StaticResource ActionButton}" Content="⚙" ToolTip="بيانات الاشتراك" Click="Settings_Click"/>
                            <Button Style="{StaticResource ActionButton}" Content="◉" ToolTip="تسجيل الخروج" Click="Logout_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,14" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource TileButton}" Background="#1687F8" Click="OpenLive_Click" Margin="4">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="▣" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="LIVE TV" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="آخر تحديث: —" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,70,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource TileButton}" Background="#F49A00" Click="OpenMovies_Click" Margin="4">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="▶" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="MOVIES" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="آخر تحديث: —" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,70,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource TileButton}" Background="#245FE8" Click="OpenSeries_Click" Margin="4">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="▤" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="SERIES" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="آخر تحديث: —" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,70,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Grid Grid.Row="2" Height="105" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource TileButton}" Background="{StaticResource PanelBrush}" Click="MatchSchedule_Click" Margin="4">
                        <StackPanel HorizontalAlignment="Center"><TextBlock Text="◉" Foreground="{StaticResource AccentBrush}" FontSize="26" HorizontalAlignment="Center"/><TextBlock Text="Match Schedule" Foreground="White" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                    <Button Grid.Column="1" Style="{StaticResource TileButton}" Background="{StaticResource PanelBrush}" Click="Downloads_Click" Margin="4">
                        <StackPanel HorizontalAlignment="Center"><TextBlock Text="⬇" Foreground="{StaticResource AccentBrush}" FontSize="26" HorizontalAlignment="Center"/><TextBlock Text="Downloads" Foreground="White" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource TileButton}" Background="{StaticResource PanelBrush}" Click="Refresh_Click" Margin="4">
                        <StackPanel HorizontalAlignment="Center"><TextBlock Text="⟳" Foreground="{StaticResource AccentBrush}" FontSize="26" HorizontalAlignment="Center"/><TextBlock Text="Refresh" Foreground="White" FontWeight="SemiBold"/></StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <Grid x:Name="SectionView" Grid.Row="0" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="10" Margin="0,0,0,10">
                    <Grid FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ActionButton}" Content="←" ToolTip="رجوع" Click="Back_Click"/>
                        <TextBlock Grid.Column="1" x:Name="CurrentSectionTitle" Foreground="White" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,20,0"/>
                        <TextBox Grid.Column="2" x:Name="ContentSearchBox" Height="38" Padding="12,8" VerticalContentAlignment="Center" Background="#20253D" Foreground="White" BorderThickness="0" TextChanged="ContentSearch_TextChanged" ToolTip="Search by series or movie name"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <Button Style="{StaticResource ActionButton}" Content="⬇" ToolTip="التنزيلات" Click="Downloads_Click"/>
                            <Button Style="{StaticResource ActionButton}" Content="⟳" ToolTip="تحديث" Click="Refresh_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" FlowDirection="LeftToRight">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="12" Margin="0,0,10,0" Padding="10">
                        <DockPanel FlowDirection="RightToLeft">
                            <TextBlock DockPanel.Dock="Top" Text="التصنيفات" Foreground="White" FontSize="20" FontWeight="Bold" Margin="8,8,8,12"/>
                            <TextBox x:Name="CategorySearchBox" DockPanel.Dock="Top" Height="36" Padding="9,7" Margin="4,0,4,8" Background="#20253D" Foreground="White" BorderThickness="0" TextChanged="CategorySearch_TextChanged" ToolTip="بحث في التصنيفات"/>
                            <ListBox x:Name="CategoryList" SelectionChanged="Category_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="White" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="10,9"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                        <Setter Property="Foreground" Value="#DCE2F6"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Margin" Value="0,1"/>
                                        <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1687F8"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#111426" CornerRadius="12" Padding="8">
                        <ScrollViewer x:Name="ItemsScrollView" VerticalScrollBarVisibility="Auto" ScrollChanged="ItemsScroll_ScrollChanged">
                            <StackPanel>
                                <WrapPanel x:Name="ItemsPanel" Margin="6"/>
                                <Button x:Name="LoadMoreButton" Content="تحميل المزيد" Style="{StaticResource ActionButton}" HorizontalAlignment="Center" Margin="12" Click="LoadMore_Click" Visibility="Collapsed"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                <ProgressBar x:Name="Progress" Height="5" Minimum="0" Maximum="100" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock x:Name="StatusText" Text="جاهز" Foreground="{StaticResource MutedBrush}" Margin="4,5,4,0" FontSize="12"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>